{
  "entities": {
    "Task": {
      "title": "Task",
      "description": "A task extracted from various sources",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Task title" },
        "description": { "type": "string", "description": "Task description" },
        "due_date": { "type": "string", "description": "Due date in YYYY-MM-DD format" },
        "status": { "type": "string", "enum": ["pending", "completed"], "description": "Current status" },
        "source": { "type": "string", "enum": ["pdf_upload", "image_upload", "text_input"], "description": "Where the task came from" },
        "source_content": { "type": "string", "description": "The original text or base64 image data" },
        "uid": { "type": "string", "description": "Owner user ID" },
        "created_at": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["title", "status", "uid", "created_at"]
    }
  },
  "firestore": {
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Collection of user tasks"
    }
  }
}
